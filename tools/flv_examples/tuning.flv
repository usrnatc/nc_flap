// this file produces two graphs stacked vertically on eachother
//
//
// something like this
//
//  +-----------------------------------------------------+
//  |                                                     |
//  |           the rate graph                            |
//  |                                                     |
//  +-----------------------------------------------------+
//  |                                                     |
//  |           the roll and pitch graph                  |
//  |                                                     |
//  +-----------------------------------------------------+
//
// how would someone be able to say, graph this on the left axis and this 
// on the right?
//

var cruise = mode(AUTO) & GPS.Spd > 8;

attitude {
    graph(
        ATT.Roll[cruise],
        ATT.DesRoll[cruise],
        ATT.Pitch[cruise],
        ATT.DesPitch[cruise]
    );
}
